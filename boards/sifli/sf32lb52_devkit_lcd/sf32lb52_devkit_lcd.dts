/dts-v1/;

#include <sifli/sf32lb52x.dtsi>
#include <sifli/sf32lb52x-ram012.dtsi>
#include <zephyr/dt-bindings/dma/sf32lb52x-dma.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "sf32lb52_devkit_lcd-pinctrl.dtsi"

/ {
	model = "SiFli SF32LB52-DevKit-LCD";
	compatible = "sifli,sf32lb52-devkit-lcd";

	chosen {
		zephyr,flash = &py25q128ha;
		zephyr,flash-controller = &mpi2;
		zephyr,code-partition = &code;
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,crc = &crc;
		zephyr,entropy = &trng;
		zephyr,bt-hci = &mailbox;
		zephyr,display = &st7789v;
	};

	buttons {
		compatible = "gpio-keys";

		key1: key1 {
			label = "KEY1";
			gpios = <&gpioa_32_44 2 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			label = "LED0";
			gpios = <&gpioa_00_31 26 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led0 = &led0;
		sw0 = &key1;
		rtc = &rtc;
		watchdog0 = &wdt;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(240)>;
};

&hxt48 {
	status = "okay";
};

&rcc_clk {
	status = "okay";

	sifli,hdiv = <1>;
	sifli,pdiv1 = <1>;
	sifli,pdiv2 = <6>;
	sifli,sys-clk-src = "dll1";

	dll1 {
		status = "okay";
		clock-frequency = <DT_FREQ_M(240)>;
	};
};

&rcc_rst {
	status = "okay";
};

&gpioa_00_31 {
	status = "okay";
};

&gpioa_32_44 {
	status = "okay";
};

&dmac {
	status = "okay";
};

&mpi2 {
	compatible = "sifli,sf32lb-mpi-qspi-nor";
	dmas = <&dmac 0 SF32LB52X_DMA_REQ_MPI2 SF32LB_DMA_PL_MEDIUM>;
	sifli,psclr = <0>;
	sifli,lines = <4>;
	status = "okay";

	py25q128ha: flash@0 {
		compatible = "puya,py25q128ha", "jedec,qspi-nor";
		reg = <0x0>;
		size = <DT_SIZE_M(128)>;
		quad-enable-requirements = "S2B1v1";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			ptable: partition@0 {
				label = "ptable";
				reg = <0x0 DT_SIZE_K(64)>;
			};

			code: partition@10000 {
				label = "code";
				reg = <0x10000 DT_SIZE_K(16320)>;
			};
		};
	};
};

&pinctrl {
	status = "okay";
};

&usart1 {
	status = "okay";
	current-speed = <1000000>;
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
};

&wdt {
	status = "okay";
};

&rtc {
	status = "okay";
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&crc {
	status = "okay";
};

temp_sensor: &tsen {
	status = "okay";
};

&trng {
	status = "okay";
};

&mailbox {
	status = "okay";
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
};

&lcdc {
	status = "okay";

	mipi_dbi: mipi-dbi {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-0 = <&lcdc_8080_default>;
		pinctrl-names = "default";

		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			led-gpios = <&aw9523_gpio 8 GPIO_ACTIVE_LOW>;
			led1-gpios = <&aw9523_gpio 9 GPIO_ACTIVE_LOW>;
			led2-gpios = <&aw9523_gpio 10 GPIO_ACTIVE_LOW>;
			mipi-mode = "MIPI_DBI_MODE_8080_BUS_8_BIT";
			mipi-max-frequency = <12000000>;
			width = <240>;
			height = <320>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x1F>;
			gctrl = <0x35>;
			vdvs = <0x20>;
			mdac = <0x00>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 00];
			pwctrl1-param = [a4 a1];
			pvgam-param = [D0 08 11 08 0C 15 39 33 50 36 13 14 29 2D];
			nvgam-param = [D0 08 10 08 06 06 39 44 51 0B 16 14 2F 31];
			ram-param = [00 F0];
			rgb-param = [40 02 14];
		};
	};
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_default>;
	pinctrl-names = "default";

	aw9523b@5b {
		compatible = "awinic,aw9523b";
		reg = <0x5b>;
		status = "okay";

		aw9523_gpio: gpio {
			compatible = "awinic,aw9523b-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			port0-push-pull;
			int-gpios = <&gpioa_00_31 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			reset-gpios = <&gpioa_00_31 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};
};
